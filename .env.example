# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Get a key from your Scrape Creators account.
SCRAPE_CREATORS_API_KEY=

# --- everything below is optional; defaults are in the code ---

# Change these if the live endpoint or its parameter names differ from what the
# defaults assume. They exist so a provider change is a config edit, not a patch.
# SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com
# SCRAPE_CREATORS_TIKTOK_SEARCH_PATH=/v1/tiktok/search/keyword

# Point at a JSON file to override how an upstream response is read. Same shape
# as FIELD_MAP in normalize.cjs; merged over the defaults, so name only what is
# wrong. Use this the first time real data disagrees with the built-in guesses.
# VIRAL_RADAR_FIELD_MAP=./scripts/viral-radar/field-map.local.json

# Accepted values for the period / sort inputs, comma separated. Widen these if
# the provider accepts values the defaults reject.
# VIRAL_RADAR_PERIODS=24h,7d,30d,90d,180d,all
# VIRAL_RADAR_SORTS=relevance,likes,date

# VIRAL_RADAR_PORT=8787
# VIRAL_RADAR_MAX_RESULTS=50
# VIRAL_RADAR_TIMEOUT_MS=20000
